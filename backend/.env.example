# Server Configuration
PROJECT_NAME=MediRoute API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=mediroute

# Database URL override (optional)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/mediroute
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-starting
AUTH_TOKEN_TTL_MINUTES=720

# Optional emergency contact notifications. Configure at least one provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Gemini API Key
GEMINI_API_KEY=

# SarvamAI Speech-to-Text API Key
STT_API_KEY=

