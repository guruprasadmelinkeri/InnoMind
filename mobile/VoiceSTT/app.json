{
  "expo": {
    "name": "MediRoute",
    "slug": "mediroute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VoiceSTT needs microphone access to record your voice report.",
        "NSLocationWhenInUseUsageDescription": "VoiceSTT needs your location to attach it to your voice report."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "VoiceSTT needs microphone access to record your voice report."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VoiceSTT needs your location to attach it to your voice report."
        }
      ]
    ]
  }
}
